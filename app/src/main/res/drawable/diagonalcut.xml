<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">


    <item android:top="-300dp"
                   android:right="-300dp"
                   android:left="-50dp"

                   >
        <rotate android:pivotX="0%"
                android:pivotY="100%"
                android:fromDegrees="70">

            <shape android:shape="rectangle">
                <solid android:color="@color/app_bg"/>

<!--                <stroke android:width="6dp"-->
<!--                    android:color="@color/black"/>-->

            </shape>
        </rotate>

    </item>

    <item android:top="0dp"
        android:right="-300dp"
        android:bottom="15dp"


        >
        <rotate android:pivotX="0%"
            android:pivotY="100%"
            android:fromDegrees="-20">

            <shape android:shape="rectangle">
                <gradient android:startColor="#90FF0000"
                          android:angle="-90"
                          android:endColor="#30000000"/>

                <stroke android:width="1dp"
                    android:color="#d3d3d3"/>


            </shape>
        </rotate>

    </item>

</layer-list>