<!--                android:layout_marginEnd="14dp"/>-->

            <EditText

                android:id="@+id/edt_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="Enter your name"
                android:textColor="#1E2A4A"
                android:textColorHint="#9AA3B2"
                android:textSize="14sp"
                android:inputType="textPersonName"
                />

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Contact Label -->
    <TextView
        android:id="@+id/txtContactLabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Contact Number"
        android:textStyle="bold"
        android:textColor="#1E2A4A"
        android:textSize="14sp"
        android:layout_marginTop="10dp"
        android:layout_marginStart="28dp"
        app:layout_constraintTop_toBottomOf="@id/nameCard"
        app:layout_constraintStart_toStartOf="parent"/>

    <!-- Contact Input Layout -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/contactCard"
        android:layout_width="0dp"
        android:layout_height="64dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="12dp"
        app:cardCornerRadius="18dp"
        app:cardElevation="0dp"
        app:strokeColor="#D8DEEA"
        app:strokeWidth="1dp"
        app:layout_constraintTop_toBottomOf="@id/txtContactLabel"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="18dp"
            android:paddingEnd="18dp">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:src="@drawable/ic_phone"
                android:tint="#6E7891"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="+91"
                android:textStyle="bold"
                android:textSize="14sp"
                android:textColor="#1E2A4A"
                android:layout_marginStart="14dp"/>

            <View
                android:layout_width="1dp"
                android:layout_height="24dp"
                android:background="#D8DEEA"
                android:layout_marginStart="14dp"
                android:layout_marginEnd="14dp"/>

            <EditText
                android:id="@+id/edt_contact"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@android:color/transparent"
                android:hint="Enter your contact number"
                android:textColor="#1E2A4A"
                android:textColorHint="#9AA3B2"
                android:textSize="14sp"
                android:inputType="phone"
                android:maxLength="10"/>

        </LinearLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Login Button -->
    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnLogin"
        android:layout_width="0dp"
        android:layout_height="62dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="32dp"
        android:text="Login"
        android:textAllCaps="false"
        android:textStyle="bold"
        android:textSize="18sp"
        android:textColor="@android:color/white"
        app:backgroundTint="#05286B"
        app:cornerRadius="18dp"
        app:elevation="2dp"
        app:layout_constraintTop_toBottomOf="@id/contactCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

